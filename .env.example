PROJECT_NAME=ONTIME SUBDATA LTD

SECRET_KEY=CHANGE_ME

DATABASE_URL=postgresql+psycopg2://DB_USER:DB_PASSWORD@localhost:5432/ontime_subdata

REDIS_URL=redis://localhost:6379

DEBUG=True

# Monnify Dynamic Invoice wallet funding. Use the sandbox host and test keys
# during development; use https://api.monnify.com and live keys in production.
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=

# Topify dedicated virtual accounts (Moniepoint only: bankCode ["30901"]).
# Keep disabled until Topify provides an approved business ID and credentials.
# Test and live keys use the same API host; never expose either key in clients.
TOPIFY_ENABLED=false
TOPIFY_BASE_URL=https://apipay.topify.ng
TOPIFY_API_KEY=
TOPIFY_WEBHOOK_SECRET=
TOPIFY_BUSINESS_ID=

FRONTEND_URL=http://localhost:3000

# BigiSub data purchase: provider PIN only (never the customer ONTIME PIN)
BIGISUB_PROVIDER_PIN=
# Verify this legacy path in BigiSub Settings > API Doc before production
BIGISUB_DATA_PURCHASE_PATH=
